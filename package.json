    "migrate": "tsx server/migrate.ts",
    "seed:admin": "tsx server/seed-admin.ts",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "test:api": "tsx --test server/tests/domain.test.ts",
